{
    "name": "silverstripe/installer",
    "type": "silverstripe-recipe",
    "description": "The SilverStripe Framework Installer",
    "license": "BSD-3-Clause",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/kalakotra/silverstripe-dropzone.git"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/recipe-plugin": "~2.1.0@stable",
        "silverstripe/vendor-plugin": "~2.1.0@stable",
        "silverstripe/recipe-cms": "~5.4.0@stable",
        "silverstripe-themes/simple": "~3.3.2@stable",
        "silverstripe/linkfield": "^4.1",
        "silverstripe/login-forms": "~5.3.0@stable",
        "axllent/silverstripe-minifier": "^2.0",
        "axllent/silverstripe-scaled-uploads": "^2.3",
        "jonom/focuspoint": "^5.0",
        "symbiote/silverstripe-grouped-cms-menu": "^4.1",
        "symbiote/silverstripe-gridfieldextensions": "^4.1",
        "unclecheese/display-logic": "^3.0",
        "lekoala/silverstripe-cms-actions": "^1.7",
        "tractorcow/silverstripe-autocomplete": "^5.0",
        "mpdf/mpdf": "^8.2",
        "unclecheese/dropzone": "5.x-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
