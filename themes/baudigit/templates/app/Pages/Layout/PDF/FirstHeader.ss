<header name="Header">
    <div class="row">
        <div class="col-3">
            $SiteConfig.Logo
        </div>
        <div class="col-9 text-end">
            <h2>$SiteConfig.CompanyName</h2>
            <p>
                $SiteConfig.CompanyAddressLine1<br>
                $SiteConfig.CompanyAddressLine2<br>
                $SiteConfig.CompanyContactPhone<br>
                $SiteConfig.CompanyContactEmail
            </p>
        </div>
    </div>
</header>